---
import { type iconsType, socialLinks } from 'astro-pure/types'
import { Icon } from 'astro-pure/user'

interface SubstatsItem {
  platform: string
  icon: (typeof socialLinks)[number]
  color?: string
  link?: string
  text: string
  api?: string
  count?: number
}

type Props = {
  stats: SubstatsItem[]
}

const { stats } = Astro.props as Props

async function fetchInitialCount(item: SubstatsItem) {
  if (!item.api) return item.count

  try {
    // Zhihu route in substats may fail due anti-bot checks; use official public API as fallback.
    if (item.api.startsWith('zhihu/')) {
      const token = item.api.slice('zhihu/'.length)
      const response = await fetch(
        `https://www.zhihu.com/api/v4/members/${encodeURIComponent(token)}?include=follower_count`
      )
      if (!response.ok) return item.count
      const data = await response.json()
      return typeof data.follower_count === 'number' ? data.follower_count : item.count
    }

    const response = await fetch(`https://api.swo.moe/stats/${item.api}`)
    if (!response.ok) return item.count
    const data = await response.json()
    if (!data.failed && data.count !== undefined && data.count !== null) {
      return data.count
    }
  } catch {
    return item.count
  }

  return item.count
}

const statsWithCount = await Promise.all(
  stats.map(async (item) => ({
    ...item,
    count: await fetchInitialCount(item)
  }))
)
---

<div class='rounded-2xl border border-border/80 p-3 sm:p-4'>
  <div class='grid grid-cols-1 gap-1.5 sm:grid-cols-2 sm:gap-2' data-substats-root>
  {
    statsWithCount.map(({ link, platform, icon, color, count, text, api }) => (
      <a
        class='group text-muted-foreground no-underline'
        href={link}
        target='_blank'
        rel='noopener noreferrer'
      >
        <div
          class='flex items-center gap-3 rounded-xl px-3 py-2.5 transition-colors hover:bg-muted/60'
          data-substats-api={api}
        >
          {icon && <Icon name={icon as iconsType} color={color} />}
          <div class='flex-1 text-foreground transition-colors group-hover:text-primary'>
            {platform}
          </div>
          {count !== undefined ? (
            <div class='flex items-center gap-1.5'>
              <samp class='font-medium' data-substats-count>{count}</samp>
              <span class='text-sm font-normal'>{text}</span>
            </div>
          ) : (
            <div class='flex items-center gap-1.5'>
              <samp class='font-medium' data-substats-count>--</samp>
              <span class='text-sm font-normal'>{text}</span>
            </div>
          )}
        </div>
      </a>
    ))
  }
  </div>
</div>
<div class='mt-2 text-right text-sm'>
  Display real-time; powered by <a
    class='text-muted-foreground'
    href='https://github.com/spencerwooo/substats'
    target='_blank'
    rel='noopener noreferrer'>Substats</a
  >
</div>

<script>
  const substatsCards = document.querySelectorAll<HTMLElement>('[data-substats-api]')

  substatsCards.forEach(async (card) => {
    const api = card.dataset.substatsApi
    const countNode = card.querySelector<HTMLElement>('[data-substats-count]')
    if (!api || !countNode) return

    try {
      const response = await fetch(`https://api.swo.moe/stats/${api}`)
      const data = await response.json()
      if (!data.failed && data.count !== undefined && data.count !== null) {
        countNode.textContent = String(data.count)
      }
    } catch {}
  })
</script>
