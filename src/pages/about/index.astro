---
import PageLayout from '@/layouts/CommonPage.astro'
import Substats from '@/components/about/Substats.astro'
import { socialLinks } from 'astro-pure/types'

type SocialIcon = (typeof socialLinks)[number]

const substats: {
  platform: string
  icon: SocialIcon
  color?: string
  link: string
  text: string
  api: string
}[] = [
  {
    platform: 'GitHub',
    icon: 'github',
    link: 'https://github.com/lihuss',
    text: 'followers',
    api: 'github/lihuss'
  },
  {
    platform: 'Zhihu',
    icon: 'zhihu',
    color: '#0084ff',
    link: 'https://www.zhihu.com/people/32-85-56-81-73',
    text: 'followers',
    api: 'zhihu/32-85-56-81-73'
  },
  {
    platform: 'Douyin',
    icon: 'douyin',
    color: '#FE2C55',
    link: 'https://www.douyin.com/user/MS4wLjABAAAA-Y_G376_89123456789', // Example template
    text: 'followers',
    api: 'douyin/MS4wLjABAAAA-Y_G376_89123456789' // Example template
  }
]

const headings = [
  { depth: 2, slug: 'substats', text: 'Social Networks' },
  { depth: 2, slug: 'contact', text: 'Contact' }
